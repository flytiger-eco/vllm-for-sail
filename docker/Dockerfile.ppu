# syntax=docker/dockerfile:1
# Build from this Dockerfile-only branch; no local vLLM sources are required.
# docker build --platform linux/amd64 -f docker/Dockerfile.ppu -t vllm:ppu .
# docker build --platform linux/amd64 -f docker/Dockerfile.ppu --target framework -t vllm:ppu-dev .
# The v0.34.0 nightly line uses the empty vLLM + native vllm-sail dev pair from
# cudafy-for-sail "vLLM SAIL nightly wheels" run 45347125767 (source 6182001,
# upstream 62d4bc3). These commit-id wheels are published to the office
# artifactory pypi_tmp and fetched from there at build time. deep_select is
# intentionally left on the release index and is overlaid separately per the test
# guide.
ARG PPU_BASE_IMAGE=pkg.flytiger-eco.com/docker_release/pytorch:sdk2.2.1-2.13.0-ubuntu24.04-cuda13.0-py312-20261103
ARG PPU_PIP_INDEX=https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple
ARG PIP_DEFAULT_INDEX=https://pypi.org/simple
ARG UBUNTU_MIRROR
ARG MAX_JOBS=16
ARG FFMPEG_VERSION=7.1.3
ARG FFMPEG_SHA256=e0b04c4b43d7e6d67cb6710334fb513adf13ac860532f30e1d0ac4c231f232fb
# Full wheel URLs and sha256 from the run's wheel-manifest.json.
ARG VLLM_WHEEL_URL=https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-24-1534/vllm-0.34.1.dev0+g62d4bc3c7e33b1b6c906e233e6af2d3506c482ca.d20261124.empty-cp312-cp312-linux_x86_64.whl
ARG VLLM_WHEEL_SHA256=efcc9320b422945d4f12b10dbb8b811278be84886d3aeeaf60e9f086fc440052
ARG VLLM_SAIL_WHEEL_URL=https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-24-1534/vllm_sail-0.32.0rc2.dev93+g6182001-cp312-cp312-linux_x86_64.whl
ARG VLLM_SAIL_WHEEL_SHA256=b9707e52a95f058afcd65984584d2a960efdae4e83d28586cf115219529b2760
# Keep SDK-specific local versions; never substitute upstream CUDA packages.
ARG PPU_PACKAGES="\
    acext==1.1.0+v0.2.0.ppu2.2.0 \
    cpm-kernels==1.0.11+v0.1.0.ppu2.2.0 \
    cuda-bindings==13.0.0+v0.1.0.ppu2.2.0 \
    cuda-python==13.0.0+v0.1.0.ppu2.2.0 \
    deep_ep==2.2.1+v0.1.0.ppu2.2.0 \
    deep_gemm==1.1.0+v1.1.0.ppu2.2.1 \
    deep_select==1.0.0+v1.0.0.ppu2.2.1 \
    flash_attn==2.8.2+v1.0.0.ppu2.2.1 \
    flash_attn_3==3.0.0+v1.0.0.ppu2.2.1 \
    flash_mla==2.1.0+v1.1.0.ppu2.2.1 \
    flashinfer-python==0.6.17+v0.1.0.ppu2.2.0 \
    mooncake==0.3.12.post1+v0.1.0.ppu2.2.0 \
    msa_for_sail==0.1.1+v0.1.0.ppu2.2.0 \
    pla==1.1.0+v0.1.0.ppu2.2.0 \
    sailify==1.0.0+ppu2.2.1 \
    tilelang==0.1.12+v0.1.0.ppu2.2.1 \
    torchaudio==2.11.0+v0.1.0.ppu2.2.0 \
    torchao==0.17.0+v0.1.0.ppu2.2.0 \
    torchcodec==0.15.0+v0.1.0.ppu2.2.0 \
    triton==3.7.0+v0.1.0.ppu2.2.0"

FROM ghcr.io/astral-sh/uv:0.8.18 AS uv

FROM ${PPU_BASE_IMAGE} AS base

ARG UBUNTU_MIRROR
ARG PIP_DEFAULT_INDEX

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PPU_SDK=/usr/local/PPU_SDK \
    PPU_HOME=/usr/local/PPU_SDK \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy
# Preserve the base image's CUDA_HOME/CUDA_PATH for its actual SDK mode.
ENV PATH="/opt/vllm/.venv/bin:${PPU_SDK}/bin:${PATH}" \
    LD_LIBRARY_PATH="${PPU_SDK}/lib:${LD_LIBRARY_PATH}"

COPY --from=uv /uv /uvx /usr/local/bin/

RUN if [ -n "$UBUNTU_MIRROR" ]; then \
        for f in /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources; do \
            if [ -f "$f" ]; then \
                sed -i -e "s|http://.*archive.ubuntu.com|$UBUNTU_MIRROR|g" \
                       -e "s|http://.*security.ubuntu.com|$UBUNTU_MIRROR|g" "$f"; \
            fi; \
        done; \
    fi

RUN --mount=type=cache,target=/var/cache/apt,id=ppu-vllm-apt \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git git-lfs unzip locales \
        build-essential cmake pkg-config patchelf ccache \
        libssl-dev protobuf-compiler libprotobuf-dev \
        libnuma1 libnuma-dev numactl ffmpeg libgl1 libglib2.0-0t64 \
        libibverbs1 libibverbs-dev librdmacm1 libibumad3 \
        ibverbs-providers rdma-core \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Inherit SDK torch through system-site-packages; install additions in the venv.
WORKDIR /opt/vllm
RUN uv venv --system-site-packages --python python3 .venv

RUN .venv/bin/python - <<'PY'
import platform
import sys
from importlib.metadata import version

assert sys.version_info[:2] == (3, 12), sys.version
assert platform.machine() == "x86_64", platform.machine()
print("Base torch:", version("torch"))
PY

RUN .venv/bin/python - <<'PY'
from importlib.metadata import version, PackageNotFoundError
from pathlib import Path

pins = []
for name in ("torch", "torchvision", "torchaudio", "triton"):
    try:
        pins.append(f"{name}=={version(name)}")
    except PackageNotFoundError:
        if name == "torch":
            raise
Path("base-constraints.txt").write_text("\n".join(pins) + "\n")
PY

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python .venv/bin/python --index-url "${PIP_DEFAULT_INDEX}" \
        -c base-constraints.txt \
        pip 'setuptools>=78.1.1,<81' 'setuptools-scm>=8,<9' \
        'setuptools-rust>=1.11' wheel packaging ninja pybind11 cython scikit-build-core

FROM base AS ffmpeg_builder

ARG MAX_JOBS
ARG FFMPEG_VERSION
ARG FFMPEG_SHA256

WORKDIR /build/ffmpeg

RUN apt-get update && apt-get install -y --no-install-recommends nasm zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 3 --connect-timeout 30 \
        "https://codeload.github.com/FFmpeg/FFmpeg/tar.gz/refs/tags/n${FFMPEG_VERSION}" \
        -o /tmp/ffmpeg.tar.gz \
    && echo "${FFMPEG_SHA256}  /tmp/ffmpeg.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/ffmpeg.tar.gz --strip-components=1 \
    && ./configure --prefix=/opt/ffmpeg7 \
        --enable-shared --disable-static --disable-programs \
        --disable-doc --disable-debug --disable-autodetect --enable-zlib \
    && make -j"${MAX_JOBS}" \
    && make install

FROM base AS ppu_kernels_builder

ARG PPU_PIP_INDEX
ARG MAX_JOBS
ARG PPU_PACKAGES

# Disable pip cache: wrapper sdists rename downloaded wheels and can hit EXDEV
# across cache mounts. Build each dependency separately to identify failures.
RUN source "${PPU_SDK}/envsetup.sh" ppu \
    && mkdir -p /wheels \
    && for spec in ${PPU_PACKAGES}; do \
        echo "==> Building ${spec}" \
        && MAX_JOBS="${MAX_JOBS}" .venv/bin/python -m pip wheel \
            --no-cache-dir --no-deps --no-build-isolation \
            --index-url "${PPU_PIP_INDEX}" --wheel-dir /wheels "${spec}" \
        || exit 1; \
    done

# Normalize wrapper wheel filenames using their actual distribution metadata.
RUN .venv/bin/python - <<'PY'
from pathlib import Path
from zipfile import ZipFile
from packaging.utils import parse_wheel_filename

for wheel in Path("/wheels").glob("*.whl"):
    with ZipFile(wheel) as archive:
        metadata, = (n for n in archive.namelist() if n.endswith(".dist-info/METADATA"))
    name = metadata.split("/")[0].removesuffix(".dist-info").rsplit("-", 1)[0]
    target = wheel.with_name(name + "-" + wheel.name.split("-", 1)[1])
    parse_wheel_filename(target.name)
    if target != wheel:
        assert not target.exists(), target
        wheel.rename(target)
PY

FROM base AS vllm_wheels

ARG VLLM_WHEEL_URL
ARG VLLM_WHEEL_SHA256
ARG VLLM_SAIL_WHEEL_URL
ARG VLLM_SAIL_WHEEL_SHA256

# Fetch the nightly pair from the office artifactory pypi_tmp and verify the
# wheel-manifest checksums. Keep the original basenames so the downstream
# --no-deps installs see parseable wheel filenames.
RUN mkdir -p /wheels \
    && vllm_file="$(basename "${VLLM_WHEEL_URL}")" \
    && echo "==> Fetching ${VLLM_WHEEL_URL}" \
    && curl --fail --location --retry 3 --connect-timeout 30 \
        -o "/wheels/${vllm_file}" "${VLLM_WHEEL_URL}" \
    && echo "${VLLM_WHEEL_SHA256}  /wheels/${vllm_file}" | sha256sum -c - \
    && sail_file="$(basename "${VLLM_SAIL_WHEEL_URL}")" \
    && echo "==> Fetching ${VLLM_SAIL_WHEEL_URL}" \
    && curl --fail --location --retry 3 --connect-timeout 30 \
        -o "/wheels/${sail_file}" "${VLLM_SAIL_WHEEL_URL}" \
    && echo "${VLLM_SAIL_WHEEL_SHA256}  /wheels/${sail_file}" | sha256sum -c -

FROM base AS vllm_install

ARG PPU_PIP_INDEX
ARG PIP_DEFAULT_INDEX

COPY --from=ffmpeg_builder /opt/ffmpeg7/lib /opt/ffmpeg7/lib
ENV LD_LIBRARY_PATH="/opt/ffmpeg7/lib:${LD_LIBRARY_PATH}"

COPY --from=ppu_kernels_builder /wheels /tmp/wheels/ppu
COPY --from=vllm_wheels /wheels /tmp/wheels/vllm

# Install PPU artifacts without resolving their upstream CUDA dependency pins.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python .venv/bin/python --no-deps /tmp/wheels/ppu/*.whl

RUN .venv/bin/python - <<'PY'
from importlib.metadata import version
from pathlib import Path
from zipfile import ZipFile
from email.parser import BytesParser
from packaging.requirements import Requirement

pins = dict(line.split("==", 1) for line in Path("base-constraints.txt").read_text().splitlines())
for wheel in Path("/tmp/wheels/ppu").glob("*.whl"):
    with ZipFile(wheel) as archive:
        metadata, = (n for n in archive.namelist() if n.endswith(".dist-info/METADATA"))
        name = BytesParser().parsebytes(archive.read(metadata))["Name"]
    pins[name] = version(name)
pins.update({
    "z3-solver": "4.15.4.0",
    "apache-tvm-ffi": "0.1.11",
    # vLLM 0.34 requires huggingface-hub>=2.0; transformers<5.18 caps it at <2.0.
    "transformers": "5.19.0",
    "numpy": "1.26.4",
    "numba": "0.66.0+v0.1.0.ppu2.2.0",
    "llvmlite": "0.48.0",
    # vLLM SAIL's upstream reuse lane runs in the default runtime image.
    "pytest": "9.1.0",
    "tblib": "3.1.0",
})
Path("ppu-constraints.txt").write_text("".join(f"{n}=={v}\n" for n, v in sorted(pins.items())))
Path("ppu-requirements.txt").write_text("\n".join(sorted(pins)) + "\n")
# Retain the requested NumPy/TileLang FFI versions and the PPU DeepGEMM wheel.
Path("runtime-overrides.txt").write_text(
    "numpy==1.26.4\n"
    "numba==0.66.0+v0.1.0.ppu2.2.0\n"
    # Exclude SDK-suffixed wrapper versions from the plain llvmlite release pin.
    "llvmlite===0.48.0\n"
    "apache-tvm-ffi==0.1.11\n"
    f"deep-gemm=={version('deep-gemm')}\n"
)

runtime_requirements = set()
for wheel in Path("/tmp/wheels/vllm").glob("*.whl"):
    with ZipFile(wheel) as archive:
        metadata, = (n for n in archive.namelist() if n.endswith(".dist-info/METADATA"))
        message = BytesParser().parsebytes(archive.read(metadata))
    for spec in message.get_all("Requires-Dist", []):
        requirement = Requirement(spec)
        if requirement.marker is None or requirement.marker.evaluate({"extra": ""}):
            runtime_requirements.add(spec)
Path("vllm-runtime-requirements.txt").write_text("\n".join(sorted(runtime_requirements)) + "\n")
PY

# Resolve the extracted runtime dependencies under the PPU pins and overrides.
# Install the vLLM wheels after resolving their runtime dependencies.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python .venv/bin/python \
        --index-url "${PPU_PIP_INDEX}" --extra-index-url "${PIP_DEFAULT_INDEX}" \
        --index-strategy unsafe-best-match --no-build-isolation \
        --overrides runtime-overrides.txt \
        -c ppu-constraints.txt -r ppu-requirements.txt \
        -r vllm-runtime-requirements.txt ray vllm-router \
    && uv pip install --python .venv/bin/python --no-deps \
        /tmp/wheels/vllm/vllm-*.whl \
        /tmp/wheels/vllm/vllm_sail-*.whl \
    && uv pip install --python .venv/bin/python --index-url "${PIP_DEFAULT_INDEX}" \
        --no-deps numpy==1.26.4 \
    && uv pip install --python .venv/bin/python --index-url "${PPU_PIP_INDEX}" \
        --no-deps ml-dtypes==0.6.0 \
    && rm -rf /tmp/wheels

# Validate installed package metadata without importing device-dependent code.
RUN .venv/bin/python - <<'PY'
from importlib.metadata import entry_points, requires, version
from pathlib import Path
from packaging.requirements import Requirement

assert version("ml-dtypes") == "0.6.0"
for group in ("vllm.platform_plugins", "vllm.general_plugins"):
    assert any(ep.name == "ppu" and ep.value.startswith("vllm_sail:")
               for ep in entry_points(group=group)), group
for line in Path("ppu-constraints.txt").read_text().splitlines():
    name, expected = line.split("==", 1)
    assert version(name) == expected, name
for spec in requires("vllm") or []:
    requirement = Requirement(spec)
    if requirement.marker and not requirement.marker.evaluate({"extra": ""}):
        continue
    actual = version(requirement.name)
    assert requirement.specifier.contains(actual, prereleases=True), (spec, actual)
print("vllm:", version("vllm"), "vllm-sail:", version("vllm-sail"))
print("torch:", version("torch"))
print("fastapi:", version("fastapi"))
print("ray:", version("ray"), "vllm-router:", version("vllm-router"))
PY

RUN .venv/bin/python -c 'from torchcodec.decoders import AudioDecoder, VideoDecoder'

RUN mkdir -p /root/.cache/huggingface /root/.cache/vllm \
    && uv pip freeze --python .venv/bin/python > installed-packages.txt

FROM vllm_install AS framework

RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb vim tmux htop less tree infiniband-diags perftest \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal \
    && rustc --version && cargo --version

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python .venv/bin/python -c ppu-constraints.txt \
        --overrides runtime-overrides.txt \
        pytest-asyncio pytest-xdist pre-commit ruff py-spy \
    && uv pip install --python .venv/bin/python --index-url "${PIP_DEFAULT_INDEX}" \
        --no-deps numpy==1.26.4 \
    && uv pip install --python .venv/bin/python --index-url "${PPU_PIP_INDEX}" \
        --no-deps ml-dtypes==0.6.0 \
    && .venv/bin/python -c 'from importlib.metadata import version; assert version("numpy") == "1.26.4"; assert version("ml-dtypes") == "0.6.0"' \
    && pre-commit --version

WORKDIR /workspace
CMD ["/bin/bash"]

# Retain SDK compilers and headers for DeepGEMM, TileLang and Triton JIT.
FROM vllm_install AS runtime

RUN /opt/vllm/.venv/bin/python -m compileall -q -j 4 \
    /opt/vllm/.venv/lib/python3.12/site-packages

ARG VLLM_BUILD_COMMIT=62d4bc3c7e33b1b6c906e233e6af2d3506c482ca
ARG VLLM_SAIL_BUILD_COMMIT=61820017f2d0a71a09af2abcadeb8efabc1c647c
LABEL org.opencontainers.image.source="https://github.com/flytiger-eco/vllm-for-sail" \
      org.opencontainers.image.version="0.34.0" \
      org.opencontainers.image.revision="${VLLM_BUILD_COMMIT}" \
      ai.vllm.sail.revision="${VLLM_SAIL_BUILD_COMMIT}"

EXPOSE 8000
WORKDIR /workspace
CMD ["/bin/bash"]
