# syntax=docker/dockerfile:1
# Build from this Dockerfile-only branch; no local vLLM sources are required.
# docker build --platform linux/amd64 -f docker/Dockerfile.ppu -t vllm:ppu .
# docker build --platform linux/amd64 -f docker/Dockerfile.ppu --target framework -t vllm:ppu-dev .
# Based on sglang-for-sail release/v0.5.23/docker/ppu.Dockerfile.
# The v0.33.0 release line uses the exact empty vLLM + native vllm-sail pair below.
ARG PPU_BASE_IMAGE=pkg.flytiger-eco.com/docker_release/pytorch:sdk2.2.0-2.13.0-ubuntu24.04-cuda13.0-py312-20261001
ARG PPU_PIP_INDEX=https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple
ARG PIP_DEFAULT_INDEX=https://pypi.org/simple
ARG UBUNTU_MIRROR
ARG MAX_JOBS=16
ARG SAILIFY_WHEEL_URL=https://download.t-head.cn/artifactory/pypi_tmp/2026-11-03-0938/sailify-1.0.0-py3-none-any.whl
ARG SAILIFY_WHEEL_SHA256=a9ad401a0319b7c95d112b3e69682427955fd7cfacec76255d3b4447e84c92a1
ARG VLLM_WHEEL_URL=https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-13-1642/vllm-0.33.1.dev0+g4ba787ec9959e566d3b587a796dff07673324da5.d20261113.empty-cp312-cp312-linux_x86_64.whl
ARG VLLM_WHEEL_SHA256=62f367d16b6b355bd3717699751a54247b63574b03ad45944a0fc2f3717804da
ARG VLLM_SAIL_WHEEL_URL=https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-13-1642/vllm_sail-0.33.0rc2.dev3+g4ac8b9c-cp312-cp312-linux_x86_64.whl
ARG VLLM_SAIL_WHEEL_SHA256=8f63e1666fe31e697dfe349abe481c9a52ed3cacff67fd019b77a21d10eef5ac
# The torchcodec wrapper index omits this existing wheel for the pinned base.
ARG TORCHCODEC_WHEEL_URL=https://pkg.flytiger-eco.com/artifactory/pypi_generic/torchcodec/0.15.0+v0.1.0.ppu2.2.0/torchcodec-0.15.0+cu130torch2.13.0ubuntu2404ce-cp312-cp312-linux_x86_64.whl
ARG TORCHCODEC_WHEEL_SHA256=6cacb4ece165e2eaf157f549526a315845b047c4d2c5a70895b8a0e0abe1d938
# Keep SDK-specific local versions; never substitute upstream CUDA packages.
ARG PPU_PACKAGES="\
    acext==1.1.0+v0.2.0.ppu2.2.0 \
    cpm-kernels==1.0.11+v0.1.0.ppu2.2.0 \
    cuda-bindings==13.0.0+v0.1.0.ppu2.2.0 \
    cuda-python==13.0.0+v0.1.0.ppu2.2.0 \
    deep_ep==2.2.0+v0.1.0.ppu2.2.0 \
    flashinfer-python==0.6.17+v0.1.0.ppu2.2.0 \
    mooncake==0.3.12.post1+v0.1.0.ppu2.2.0 \
    tilelang==0.1.12+v0.1.0.ppu2.2.1 \
    torchaudio==2.11.0+v0.1.0.ppu2.2.0 \
    torchao==0.17.0+v0.1.0.ppu2.2.0 \
    triton==3.7.0+v0.1.0.ppu2.2.0"
ARG PPU_WHEEL_URLS="\
    https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-13-2039/deep_gemm-1.1.0.dev305+v1.1.0.ppu2.2.0.gf5f31463-cp312-cp312-linux_x86_64.whl \
    https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-12-1754/flash_mla-2.1.0.dev6+v1.0.0.ppu2.2.0.gdc31ebe-cp312-cp312-linux_x86_64.whl \
    https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-11-2345/flash_attn-2.8.2-cp312-cp312-linux_x86_64.whl \
    https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-11-2345/flash_attn_3-3.0.0b1-cp39-abi3-linux_x86_64.whl \
    https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-11-2252/pla-1.1.0-cp312-cp312-linux_x86_64.whl \
    https://pkg.flytiger-eco.com/artifactory/pypi_tmp/2026-11-11-2111/msa_for_sail-0.1.1+v0.1.0.ppu2.2.0-py3-none-any.whl"

FROM ghcr.io/astral-sh/uv:0.8.18 AS uv

FROM ${PPU_BASE_IMAGE} AS base

ARG UBUNTU_MIRROR
ARG PIP_DEFAULT_INDEX

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PPU_SDK=/usr/local/PPU_SDK \
    PPU_HOME=/usr/local/PPU_SDK \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy
# Preserve the base image's CUDA_HOME/CUDA_PATH for its actual SDK mode.
ENV PATH="/opt/vllm/.venv/bin:${PPU_SDK}/bin:${PATH}" \
    LD_LIBRARY_PATH="${PPU_SDK}/lib:${LD_LIBRARY_PATH}"

COPY --from=uv /uv /uvx /usr/local/bin/

RUN if [ -n "$UBUNTU_MIRROR" ]; then \
        for f in /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources; do \
            if [ -f "$f" ]; then \
                sed -i -e "s|http://.*archive.ubuntu.com|$UBUNTU_MIRROR|g" \
                       -e "s|http://.*security.ubuntu.com|$UBUNTU_MIRROR|g" "$f"; \
            fi; \
        done; \
    fi

RUN --mount=type=cache,target=/var/cache/apt,id=ppu-vllm-apt \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git git-lfs unzip locales \
        build-essential cmake pkg-config patchelf ccache \
        libssl-dev protobuf-compiler libprotobuf-dev \
        libnuma1 libnuma-dev numactl ffmpeg libgl1 libglib2.0-0t64 \
        libibverbs1 libibverbs-dev librdmacm1 libibumad3 \
        ibverbs-providers rdma-core \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Inherit SDK torch through system-site-packages; install additions in the venv.
WORKDIR /opt/vllm
RUN uv venv --system-site-packages --python python3 .venv

RUN .venv/bin/python - <<'PY'
import platform
import sys
import torch

assert sys.version_info[:2] == (3, 12), sys.version
assert platform.machine() == "x86_64", platform.machine()
assert torch.version.cuda is not None, "Expected GPU-enabled SAIL torch"
print("Base torch:", torch.__version__, "SAIL:", getattr(torch.version, "sail", None))
PY

RUN .venv/bin/python - <<'PY'
from importlib.metadata import version, PackageNotFoundError
from pathlib import Path

pins = []
for name in ("torch", "torchvision", "torchaudio", "triton"):
    try:
        pins.append(f"{name}=={version(name)}")
    except PackageNotFoundError:
        if name == "torch":
            raise
Path("base-constraints.txt").write_text("\n".join(pins) + "\n")
PY

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python .venv/bin/python --index-url "${PIP_DEFAULT_INDEX}" \
        -c base-constraints.txt \
        pip 'setuptools>=78.1.1,<81' 'setuptools-scm>=8,<9' \
        'setuptools-rust>=1.11' wheel packaging ninja pybind11 cython scikit-build-core

FROM base AS ppu_kernels_builder

ARG PPU_PIP_INDEX
ARG MAX_JOBS
ARG SAILIFY_WHEEL_URL
ARG SAILIFY_WHEEL_SHA256
ARG TORCHCODEC_WHEEL_URL
ARG TORCHCODEC_WHEEL_SHA256
ARG PPU_PACKAGES
ARG PPU_WHEEL_URLS

# Disable pip cache: wrapper sdists rename downloaded wheels and can hit EXDEV
# across cache mounts. Build each dependency separately to identify failures.
RUN source "${PPU_SDK}/envsetup.sh" ppu \
    && mkdir -p /wheels \
    && curl --fail --location --retry 3 --connect-timeout 30 \
        "${SAILIFY_WHEEL_URL}" -o /wheels/sailify-1.0.0-py3-none-any.whl \
    && echo "${SAILIFY_WHEEL_SHA256}  /wheels/sailify-1.0.0-py3-none-any.whl" | sha256sum -c - \
    && curl --fail --location --retry 3 --connect-timeout 30 \
        "${TORCHCODEC_WHEEL_URL}" -o /wheels/torchcodec-0.15.0+v0.1.0.ppu2.2.0-cp312-cp312-linux_x86_64.whl \
    && echo "${TORCHCODEC_WHEEL_SHA256}  /wheels/torchcodec-0.15.0+v0.1.0.ppu2.2.0-cp312-cp312-linux_x86_64.whl" | sha256sum -c - \
    && for spec in ${PPU_PACKAGES} ${PPU_WHEEL_URLS}; do \
        echo "==> Building ${spec}" \
        && MAX_JOBS="${MAX_JOBS}" .venv/bin/python -m pip wheel \
            --no-cache-dir --no-deps --no-build-isolation \
            --index-url "${PPU_PIP_INDEX}" --wheel-dir /wheels "${spec}" \
        || exit 1; \
    done

# Normalize wrapper wheel filenames using their actual distribution metadata.
RUN .venv/bin/python - <<'PY'
from pathlib import Path
from zipfile import ZipFile
from packaging.utils import parse_wheel_filename

for wheel in Path("/wheels").glob("*.whl"):
    with ZipFile(wheel) as archive:
        metadata, = (n for n in archive.namelist() if n.endswith(".dist-info/METADATA"))
    name = metadata.split("/")[0].removesuffix(".dist-info").rsplit("-", 1)[0]
    target = wheel.with_name(name + "-" + wheel.name.split("-", 1)[1])
    parse_wheel_filename(target.name)
    if target != wheel:
        assert not target.exists(), target
        wheel.rename(target)
PY

FROM base AS vllm_wheels

ARG VLLM_WHEEL_URL
ARG VLLM_WHEEL_SHA256
ARG VLLM_SAIL_WHEEL_URL
ARG VLLM_SAIL_WHEEL_SHA256

WORKDIR /wheels
RUN curl --fail --location --retry 3 --connect-timeout 30 -O "${VLLM_WHEEL_URL}" \
    && curl --fail --location --retry 3 --connect-timeout 30 -O "${VLLM_SAIL_WHEEL_URL}" \
    && printf '%s  %s\n' \
        "${VLLM_WHEEL_SHA256}" "${VLLM_WHEEL_URL##*/}" \
        "${VLLM_SAIL_WHEEL_SHA256}" "${VLLM_SAIL_WHEEL_URL##*/}" | sha256sum -c -

FROM base AS vllm_install

ARG PPU_PIP_INDEX
ARG PIP_DEFAULT_INDEX

COPY --from=ppu_kernels_builder /wheels /tmp/wheels/ppu
COPY --from=vllm_wheels /wheels /tmp/wheels/vllm

# Install PPU artifacts without resolving their upstream CUDA dependency pins.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python .venv/bin/python --no-deps /tmp/wheels/ppu/*.whl

RUN .venv/bin/python - <<'PY'
from importlib.metadata import version
from pathlib import Path
from zipfile import ZipFile
from email.parser import BytesParser

pins = dict(line.split("==", 1) for line in Path("base-constraints.txt").read_text().splitlines())
for wheel in Path("/tmp/wheels/ppu").glob("*.whl"):
    with ZipFile(wheel) as archive:
        metadata, = (n for n in archive.namelist() if n.endswith(".dist-info/METADATA"))
        name = BytesParser().parsebytes(archive.read(metadata))["Name"]
    pins[name] = version(name)
pins.update({
    "z3-solver": "4.15.4.0",
    "apache-tvm-ffi": "0.1.11",
    "transformers": "5.16.1",
    "numpy": "1.26.4",
})
Path("ppu-constraints.txt").write_text("".join(f"{n}=={v}\n" for n, v in sorted(pins.items())))
Path("ppu-requirements.txt").write_text("\n".join(sorted(pins)) + "\n")
# Retain the requested NumPy/TileLang FFI versions and the PPU DeepGEMM wheel.
Path("runtime-overrides.txt").write_text(
    "numpy==1.26.4\n"
    "apache-tvm-ffi==0.1.11\n"
    f"deep-gemm=={version('deep-gemm')}\n"
)
PY

# Resolve dependencies for the selected PPU packages, Ray and vLLM Router.
# Install both vLLM wheels without resolving their dependency metadata.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python .venv/bin/python \
        --index-url "${PPU_PIP_INDEX}" --extra-index-url "${PIP_DEFAULT_INDEX}" \
        --index-strategy unsafe-best-match --no-build-isolation \
        --overrides runtime-overrides.txt \
        -c ppu-constraints.txt -r ppu-requirements.txt ray vllm-router \
    && uv pip install --python .venv/bin/python --no-deps \
        /tmp/wheels/vllm/vllm-*.whl \
        /tmp/wheels/vllm/vllm_sail-*.whl \
    && uv pip install --python .venv/bin/python --index-url "${PIP_DEFAULT_INDEX}" \
        --no-deps numpy==1.26.4 \
    && rm -rf /tmp/wheels

# These checks need the SDK libraries, but do not run inference or require a PPU.
RUN .venv/bin/python - <<'PY'
import importlib
from importlib.metadata import entry_points, version
from pathlib import Path
import torch
import vllm
import vllm_sail
from vllm_sail.compat import check_vllm_compatibility
from vllm_sail.native.extensions import import_kernels

check_vllm_compatibility()
for name in ("_upstream_C", "_upstream_moe_C", "_C", "_moe_C"):
    module = importlib.import_module(f"vllm_sail.{name}")
    print(name, module.__file__)
import_kernels(strict=True)
for group in ("vllm.platform_plugins", "vllm.general_plugins"):
    assert any(ep.name == "ppu" and ep.value.startswith("vllm_sail:")
               for ep in entry_points(group=group)), group
for line in Path("ppu-constraints.txt").read_text().splitlines():
    name, expected = line.split("==", 1)
    assert version(name) == expected, name
print("vllm:", vllm.__version__, "vllm-sail:", vllm_sail.__version__)
print("torch:", torch.__version__)
print("ray:", version("ray"), "vllm-router:", version("vllm-router"))
PY

RUN mkdir -p /root/.cache/huggingface /root/.cache/vllm \
    && uv pip freeze --python .venv/bin/python > installed-packages.txt

FROM vllm_install AS framework

RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb vim tmux htop less tree infiniband-diags perftest \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python .venv/bin/python -c ppu-constraints.txt \
        --overrides runtime-overrides.txt \
        pytest pytest-asyncio pytest-xdist pre-commit ruff py-spy \
    && uv pip install --python .venv/bin/python --index-url "${PIP_DEFAULT_INDEX}" \
        --no-deps numpy==1.26.4 \
    && .venv/bin/python -c 'import numpy; assert numpy.__version__ == "1.26.4"' \
    && pre-commit --version

WORKDIR /workspace
CMD ["/bin/bash"]

# Retain SDK compilers and headers for DeepGEMM, TileLang and Triton JIT.
FROM vllm_install AS runtime

ARG VLLM_BUILD_COMMIT=4ba787ec9959e566d3b587a796dff07673324da5
ARG VLLM_SAIL_BUILD_COMMIT=4ac8b9ccc4c68642746926a4c76e85c5db2cb8b9
LABEL org.opencontainers.image.source="https://github.com/flytiger-eco/vllm-for-sail" \
      org.opencontainers.image.version="0.33.0" \
      org.opencontainers.image.revision="${VLLM_BUILD_COMMIT}" \
      ai.vllm.sail.revision="${VLLM_SAIL_BUILD_COMMIT}"

EXPOSE 8000
WORKDIR /workspace
CMD ["/bin/bash"]
